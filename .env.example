# Database connection string - MongoDB Cloud
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/blog-db?retryWrites=true&w=majority

# Used to encrypt JWT tokens - Generate a random 48-character hex string
# Store in AWS Secrets Manager, do NOT commit to git
PAYLOAD_SECRET=your-secure-48-character-hex-string-here

# Addresses, with no trailing slash. NEXT_PUBLIC_ values are fixed into the build, so set them for builds.
# Outside development a missing address is left empty (with a build warning), never localhost.

# This website's public address, for share links, canonical links, the sitemap and robots.txt. Local: http://localhost:3000, production: https://neuroncx.netlify.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# The Payload CMS address, for media files and live preview in the browser and for API calls. Local: http://localhost:3001, production: https://main.duebzy83yxxuo.amplifyapp.com
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001

# Optional, server only: a different CMS address for server calls; leave unset to use NEXT_PUBLIC_PAYLOAD_URL. Local: http://localhost:3001, production: https://main.duebzy83yxxuo.amplifyapp.com
CMS_URL=http://localhost:3001

# Secret used to authenticate cron jobs - Generate a random 48-character hex string
# Store in AWS Secrets Manager, do NOT commit to git
CRON_SECRET=your-secure-48-character-hex-string-here

# Used to validate preview requests - Generate a random 48-character hex string
# Store in AWS Secrets Manager, do NOT commit to git
PREVIEW_SECRET=your-secure-48-character-hex-string-here

# AWS S3 configuration for media storage
# These exact names are required by Payload config and Amplify build env export
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-iam-user-access-key
S3_SECRET_ACCESS_KEY=your-iam-user-secret-key
S3_BUCKET=your-blog-bucket-name

# Contact form protection (src/utilities/enquiryGuard.ts). Each is off until set.
# Cloudflare Turnstile: create a widget for the site's domain in the Cloudflare dashboard.
# The site key is fixed into the build; set both keys together (with one alone, nothing is checked).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared with the CMS (same value as ENQUIRY_SECRET on Amplify): sent with each enquiry so the CMS
# accepts enquiries from this site only. Set it here and deploy first, then on the CMS.
ENQUIRY_SECRET=
